# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# AI Assistants
# Claude Code session files
.claude/
.claude_cache/
claude-*
*.claude
CLAUDE.md

# Gemini CLI files
.gemini/
.geminicli/
gemini-*
*.gemini
GEMINI.md

# Copilot files
.copilot/
copilot-*
*.copilot


# built binaries
/lsp
/dslgen
/validator
/repl
/ast_viewer_bin
# example runtime artifacts (generated by the demos themselves)
examples/audio_dsl/*.wav
examples/audio_dsl/audio_dsl
examples/audio_dsl/test_dsl
examples/image_dsl/*.png
examples/image_dsl/*.jpg
examples/image_dsl/final_output.jpg
examples/http_dsl/bin/
# artifacts written to the cwd when running examples from the repo root
/calculator.json
/*.wav
